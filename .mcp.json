{
  "mcpServers": {
    "mcp-debugger": {
      "command": "npx",
      "args": [
        "-y",
        "@debugmcp/mcp-debugger@0.24.2",
        "stdio",
        "--log-file",
        ".claude/mcp-debugger.log"
      ],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_DATA}/debugpy"
      }
    }
  }
}
